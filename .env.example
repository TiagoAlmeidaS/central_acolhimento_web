# Monolito Next.js
# Neste estagio, web e backend vivem no mesmo projeto.

# Postgres conectado pela Vercel Marketplace.
# Em 2026, o caminho oficial da Vercel para Postgres e usar uma integracao de Marketplace,
# como Neon. O projeto aceita estas variaveis nesta ordem:
# 1. POSTGRES_URL_NON_POOLING
# 2. POSTGRES_URL
# 3. DATABASE_URL

POSTGRES_URL_NON_POOLING=postgres://user:password@host/database
POSTGRES_URL=postgres://user:password@host/database?sslmode=require
DATABASE_URL=postgres://user:password@host/database

# Opcional: usar apenas em ambiente sem banco, para pular migrations no build
SKIP_DB_MIGRATIONS=false

# ── Serviço de e-mail transacional (Resend) ──────────────────────────────────
# Obtenha sua chave em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Endereço remetente dos e-mails transacionais (ex: redefinição de senha).
# Deve usar um domínio verificado no Resend.
# Para testes sem domínio próprio: "Central de Acolhimento <onboarding@resend.dev>"
EMAIL_FROM=Central de Acolhimento <noreply@seu-dominio.com.br>

# URL base do app — usada para montar links nos e-mails.
# Em desenvolvimento local: http://localhost:3000
# Em produção: URL do seu deploy (Vercel preenche automaticamente via VERCEL_PROJECT_PRODUCTION_URL)
NEXT_PUBLIC_APP_URL=https://sua-url.vercel.app
